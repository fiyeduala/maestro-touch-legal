APP_NAME="Maestro Touch Legal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
FIRM_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mtl_local
DB_USERNAME=mtl_local
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Spam checks on public forms (D48). Turnstile stays off until both keys are set.
FORMS_MIN_SECONDS=3
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Paystack. Leave empty until the firm provides keys; online payment is then simply not offered.
# Use sk_test_ keys locally and on staging, sk_live_ only in production. Never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCIES=NGN
# Only if this PHP build has no CA bundle (see docs/DECISIONS.md D7), e.g. storage/certs/cacert.pem
PAYSTACK_CA_BUNDLE=
# (Staging and local copies refuse sk_live_ keys: online payment switches off outside production.)

# Where confidential uploads live. Default storage/app/confidential; on cPanel it may point outside public_html.
# CONFIDENTIAL_STORAGE_ROOT=

# Encrypted backups (docs/BACKUP-AND-RESTORE.md). Nothing is backed up until BACKUP_PASSWORD is set.
# Use a long random password and keep a copy away from this server: without it no backup can be opened.
BACKUP_PASSWORD=
BACKUP_KEEP=7
BACKUP_AT=02:30
# BACKUP_PATH=

# Staging only (docs/DEPLOYMENT.md). With APP_ENV=staging every page needs this username and password,
# pages are marked noindex, and emails go only to STAGING_MAIL_TO (or just to the log when it is empty).
# Create the hash with: php artisan mtl:staging-password
STAGING_USER=
STAGING_PASSWORD_HASH=
STAGING_MAIL_TO=

# Browser push alerts (docs/DECISIONS.md D49). Create the pair once with: php artisan mtl:vapid-keys
# Replacing the pair later means everyone has to turn alerts on again. Without keys, alerts still show
# in the bell and by email. Test with: php artisan mtl:push-check
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Video calls on Daily.co (D50). Daily dashboard -> Developers -> API key; DAILY_DOMAIN is the Daily
# subdomain (yourteam or yourteam.daily.co). Leave recording off in the Daily dashboard.
# Test with: php artisan mtl:video-check
DAILY_API_KEY=
DAILY_DOMAIN=
MEETING_REMINDER_MINUTES=15
